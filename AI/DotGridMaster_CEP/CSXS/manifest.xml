<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="6.0"
ExtensionBundleId="com.dotgridmaster.cep"
ExtensionBundleVersion="1.0.0"
ExtensionBundleName="DotGridMaster"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

<ExtensionList>
<Extension Id="com.dotgridmaster.panel" Version="1.0.0" />
</ExtensionList>

<ExecutionEnvironment>
<HostList>
<!-- Illustrator 2024+ (v28.0+) -->
<Host Name="ILST" Version="[28.0,99.9]" />
</HostList>
<LocaleList>
<Locale Code="All" />
</LocaleList>
<RequiredRuntimeList>
<RequiredRuntime Name="CSXS" Version="11.0" />
</RequiredRuntimeList>
</ExecutionEnvironment>

<DispatchInfoList>
<Extension Id="com.dotgridmaster.panel">
<DispatchInfo>
<Resources>
<MainPath>./index.html</MainPath>
<ScriptPath>./jsx/hostscript.jsx</ScriptPath>
<CEFCommandLine>
<Parameter>--enable-nodejs</Parameter>
<Parameter>--mixed-context</Parameter>
</CEFCommandLine>
</Resources>
<Lifecycle>
<AutoVisible>true</AutoVisible>
</Lifecycle>
<UI>
<Type>Panel</Type>
<Menu>DotGridMaster</Menu>
<Geometry>
<Size>
<Height>600</Height>
<Width>280</Width>
</Size>
<MinSize>
<Height>400</Height>
<Width>260</Width>
</MinSize>
<MaxSize>
<Height>1200</Height>
<Width>400</Width>
</MaxSize>
</Geometry>
<Icons>
<Icon Type="Normal">./icons/icon-light.svg</Icon>
<Icon Type="DarkNormal">./icons/icon-dark.svg</Icon>
</Icons>
</UI>
</DispatchInfo>
</Extension>
</DispatchInfoList>
</ExtensionManifest>

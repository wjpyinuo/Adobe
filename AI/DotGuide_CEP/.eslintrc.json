{
  "env": {
    "browser": true,
    "es6": true
  },
  "globals": {
    "CSInterface": "readonly",
    "GridDebugger": "readonly",
    "app": "readonly",
    "RulerUnits": "readonly",
    "DocumentColorSpace": "readonly",
    "RGBColor": "readonly",
    "CMYKColor": "readonly",
    "Promise": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 2020
  },
  "ignorePatterns": ["CSInterface.js"],
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "args": "none"
      }
    ],
    "no-console": "off",
    "semi": [
      "error",
      "always"
    ],
    "no-undef": "error",
    "no-redeclare": "warn"
  }
}

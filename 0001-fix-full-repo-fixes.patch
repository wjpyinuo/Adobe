+  <line class="grid-line" x1="222" y1="204" x2="222" y2="344"/>
+  <line class="grid-line" x1="243" y1="204" x2="243" y2="344"/>
+  <line class="grid-line" x1="268" y1="204" x2="268" y2="344"/>
+  <line class="grid-line" x1="12" y1="204" x2="268" y2="204"/>
+  <line class="grid-line" x1="12" y1="344" x2="268" y2="344"/>
+
+  <!-- 按钮 -->
+  <rect class="btn-primary" x="12" y="358" width="120" height="28"/>
+  <text class="btn-text" x="44" y="376">应用网格</text>
+  <rect fill="#3a3a3a" x="142" y="358" width="56" height="28" rx="4"/>
+  <text class="text-primary" x="156" y="376" text-anchor="middle" font-size="10">预览</text>
+  <rect fill="#3a3a3a" x="208" y="358" width="60" height="28" rx="4"/>
+  <text class="text-primary" x="230" y="376" text-anchor="middle" font-size="10">清除</text>
+
+  <!-- 底部状态栏 -->
+  <rect fill="#252525" x="0" y="396" width="280" height="24"/>
+  <text class="text-secondary" x="12" y="412">就绪</text>

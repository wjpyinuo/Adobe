+  <text class="btn-text" x="38" y="418">应用安全区</text>
+  <rect fill="#3a3a3a" x="142" y="400" width="56" height="28" rx="4"/>
+  <text class="text-primary" x="156" y="418" text-anchor="middle" font-size="10">清除</text>
+</svg>

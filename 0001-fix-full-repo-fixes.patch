+  <text class="text-label" x="216" y="145">左边距</text>
+  <rect class="input-bg" x="216" y="149" width="52" height="22"/>
+  <text class="text-primary" x="236" y="164">0</text>
+
+  <line class="divider" x1="12" y1="182" x2="268" y2="182"/>
+
+  <!-- 预览区域 -->
+  <text class="text-label" x="12" y="198">预览</text>
+  <rect fill="#252525" x="12" y="204" width="256" height="140" rx="4"/>
